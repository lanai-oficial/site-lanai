-.site-footer { display:grid; grid-template-columns:1.2fr .7fr 1fr; gap:3rem; padding:5rem clamp(1.25rem,5vw,5rem) 2rem; color:white; background:#181815; }.site-footer div a { display:block; margin:.5rem 0; }.site-footer .footer-link { text-decoration:underline; text-underline-offset:.3rem; }.site-footer small { grid-column:1/-1; border-top:1px solid rgba(255,255,255,.2); padding-top:2rem; }
+.site-footer { display:grid; grid-template-columns:1.2fr .7fr 1fr; gap:3rem; padding:5rem clamp(1.25rem,5vw,5rem) 2rem; color:white; background:var(--brand-ink); }.site-footer div a { display:block; margin:.5rem 0; }.site-footer .footer-link { text-decoration:underline; text-underline-offset:.3rem; }.site-footer small { grid-column:1/-1; border-top:1px solid rgba(255,255,255,.2); padding-top:2rem; }
 @media (max-width:1050px) { .desktop-nav { display:none!important; }.mobile-nav { display:block; position:relative; }.mobile-nav summary { cursor:pointer; list-style:none; font-size:.75rem; letter-spacing:.12em; text-transform:uppercase; }.mobile-nav summary::-webkit-details-marker { display:none; }.mobile-nav[open] nav { position:absolute; z-index:10; top:2.5rem; right:0; width:min(85vw,320px); padding:1.5rem; display:flex; flex-direction:column; align-items:stretch; gap:0; background:var(--paper); border:1px solid var(--line); box-shadow:0 1rem 3rem rgba(0,0,0,.15); }.mobile-nav nav a { padding:.75rem; }.mobile-nav nav .nav-cta { margin-top:.75rem; text-align:center; } }
 @media (max-width:800px) { .site-header { height:70px; padding:1.2rem; }.hero,.detail-page,.profile-hero { grid-template-columns:1fr; }.hero-shape { min-height:45svh; clip-path:ellipse(85% 95% at 45% 5%); }.hero-copy { padding:3rem 1.25rem 5rem; }.universe-grid,.category-grid { grid-template-columns:1fr; }.universe-card { min-height:360px; }.category-card { min-height:360px; }.professional-grid { grid-template-columns:1fr; }.portrait-placeholder { min-height:400px; }.portfolio-grid,.profile-services,.contact-grid,.site-footer,.universe-intro,.booking-band,.directory-group { grid-template-columns:1fr; }.site-footer small { grid-column:auto; }.detail-visual { min-height:45svh; }.section-heading { align-items:flex-start; flex-direction:column; }.service-row { grid-template-columns:2rem 1fr auto; padding:1.5rem .5rem; gap:1rem; }.service-row>div>p:last-child { display:none; }.category-directory>a { grid-template-columns:2rem 1fr auto; gap:1rem; }.directory-group { gap:2rem; }.universe-hero { min-height:60svh; } }
 @media (max-width:480px) { .category-grid { grid-template-columns:1fr; }.category-card { min-height:300px; }.section { padding-left:1.25rem; padding-right:1.25rem; } }
 @media (prefers-reduced-motion:reduce) { html { scroll-behavior:auto; } *,*::before,*::after { transition:none!important; } }
